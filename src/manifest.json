{
  "manifest_version": 3,
  "name": "Bingy",
  "version": "1.0.0",
  "description": "Monitors Claude usage and alerts you before limits are reached.",

  "permissions": ["storage", "notifications", "offscreen"],
  "host_permissions": ["https://claude.ai/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/settings/usage*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Bingy"
  }
}
